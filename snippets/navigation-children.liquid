<div class="main-nav-sub-links-container">
  <div>
    <ul class="main-nav-sub-links">
      {% for link in links %}
        <li>
          <a class="label-small{% if link.links != blank %} has-children{% endif %}" {% if link.url != '#' %}href="{{ link.url }}"{% endif %}>
            {{ link.title | escape }}
            {% if link.links != blank %}<span class="toggle">{% render 'icon-chevron' %}</span>{% endif %}
          </a>
          {% if link.links != blank %}
            <div class="main-nav-sub-links-container">
              <div>
                <ul class="main-nav-sub-links">
                  {% for child_link in link.links %}
                    <li>
                      <a class="label-small{% if child_link.links != blank %} has-children{% endif %}" {% if child_link.url != '#' %}href="{{ child_link.url }}"{% endif %}">
                      {{ child_link.title | escape }}
                      {% if child_link.links != blank %}<span class="toggle">{% render 'icon-chevron' %}</span>{% endif %}
                      </a>
                      {% if child_link.links != blank %}
                        <div class="main-nav-sub-links-container">
                          <div>
                            <ul class="main-nav-sub-links">
                              {% for grandchild_link in child_link.links %}
                                <li>
                                  <a class="label-small" href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a>
                                </li>
                              {% endfor %}
                            </ul>
                          </div>
                        </div>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>

            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>

</div>