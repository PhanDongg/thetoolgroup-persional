{%- assign social_accounts = 'Snapchat, Instagram, Facebook, Pinterest, Twitter, Tumblr, YouTube, Vimeo,' | split: ', ' -%}
<ul class="social-icons grid-x align-middle" data-autoload-snippet="social-icons">
    {% for social in social_accounts %}

        {%- assign social_handle = social | handleize -%}
        {% capture social_link %}social_{{ social_handle }}_link{% endcapture %}
        {% capture social_icon %}icon-{{ social_handle }}{% endcapture %}

        {% if settings[social_link] != blank %}
            <li>
                <a href="{{ settings[social_link] }}"
                   target="_blank"
                   rel="nofollow noopener"
                   title="{{ 'layout.footer.social_platform' | t: name: shop.name, platform: social }}">
                    {% case social_handle %}
                      {% when 'snapchat' %}
                        {% render 'icon-snapchat' %}
                      {% when 'instagram' %}
                        {% render 'icon-instagram' %}
                      {% when 'facebook' %}
                        {% render 'icon-facebook' %}
                      {% when 'pinterest' %}
                        {% render 'icon-pinterest' %}
                      {% when 'twitter' %}
                        {% render 'icon-twitter' %}
                      {% when 'tumblr' %}
                        {% render 'icon-tumblr' %}
                      {% when 'youtube' %}
                        {% render 'icon-youtube' %}
                      {% when 'vimeo' %}
                        {% render 'icon-vimeo' %}
                    {% endcase %}
                    <span class="show-for-sr">{{ social }}</span> </a>
            </li>
        {% endif %}

    {% endfor %}
</ul>
