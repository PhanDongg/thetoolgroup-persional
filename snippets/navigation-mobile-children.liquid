<div class="mobile-nav-sub-links-container">
  <div>
    <div class="mobile-nav-sub-links-title label-small back-toggle">
      <span>{% render 'icon-chevron' %}</span>
      {{ title }}
    </div>
    <ul class="mobile-nav-sub-links">
      {% for link in links %}
        <li>
          <a class="label-small{% if link.links != blank %} has-children toggle{% endif %}" {% if link.url == '#' %}role="button"{% else %}href="{{ link.url }}"{% endif %}>
            {{ link.title | escape }}
            {% if link.links != blank %}{% render 'icon-chevron' %}{% endif %}
          </a>

          {% if link.links != blank %}
          <div class="mobile-nav-sub-links-container">
            <div>
              <div class="mobile-nav-sub-links-title label-small back-toggle">
                {% render 'icon-chevron' %}
                {{ link.title }}
              </div>
            <ul class="mobile-nav-sub-links">
              {% for child_link in link.links %}
                <li>
                  <a class="label-small{% if child_link.links != blank %} toggle has-children{% endif %}" {% if child_link.url == '#' %}role="button"{% else %}href="{{ child_link.url }}"{% endif %}>
                    {{ child_link.title | escape }}
                    {% if child_link.links != blank %}{% render 'icon-chevron' %}{% endif %}
                  </a>

                  {% if child_link.links != blank %}
                  <div class="mobile-nav-sub-links-container">
                    <div>
                      <div class="mobile-nav-sub-links-title label-small">
                        <span class="back-toggle">{% render 'icon-chevron' %}</span>
                        {{ child_link.title }}
                      </div>
                    <ul class="mobile-nav-sub-links">
                      {% for grandchild_link in child_link.links %}
                        <li>
                          <a class="label-small" href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a>
                        </li>
                      {% endfor %}
                    </ul>
                    </div>
                  {% endif %}

                </li>
              {% endfor %}
            </ul>
            </div>
          </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</div>