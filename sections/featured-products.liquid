<div class="section section-featured-products {{ section.settings.section_theme }}" data-autoload-section="featured-products">

  <div class="grid-container">
    <div class="grid-x grid-margin-x align-middle mb-30">
      <div class="cell medium-auto text-center medium-text-left">
        <div class="overline-uppercase color-secondary mb-5">{{ section.settings.section_subheading }}</div>
        <h2>{{ section.settings.section_title }}</h2>
      </div>
      <div class="cell medium-shrink text-center">
        <a href="{{ section.settings.button_page }}" class="button button-primary">{{ section.settings.button_title }}</a>
      </div>
    </div>
  </div>

  <div class="grid-container">
      <div class="slider-wrapper">
        <div class="glide">
          <div data-glide-el="track" class="glide__track">
            <div class="glide__slides grid-x grid-margin-x featured-products-grid">
              {% for product in collections[section.settings.collection].products limit:4 %}
                <script type="application/json" class="bold-product-json">{{ product | json }}</script>
                <div class="cell large-3 small-6 align-stretch">
                  {% render 'product-tile' product: product %}
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>

</div>

{% schema %}

{
    "name": "Featured Products",
    "settings": [
        {
          "type": "header",
          "content": "Section Theme"
        },
        {
          "type": "select",
          "id": "section_theme",
          "options": [
            { "value": "", "label": "White"},
            { "value": "theme-light", "label": "Light Grey"},
            { "value": "theme-split", "label": "Split White/Light Grey"},
            { "value": "theme-split-alt", "label": "Split Light Grey/White"}
          ],
          "label": "Section Theme"
        },
        {
            "type": "header",
            "content": "Section Title"
        },
        {
            "type": "text",
            "id": "section_title",
            "label": "Title",
            "default": "Your Most Loved"
        },
        {
            "type": "text",
            "id": "section_subheading",
            "label": "Subheading"
        },
        {
            "type": "header",
            "content": "Section Button"
        },
        {
            "type": "text",
            "id": "button_title",
            "label": "Button title",
            "default": "See More"
        },
        {
            "type": "url",
            "id": "button_page",
            "label": "Link"
        },
        {
            "type": "collection",
            "id": "collection",
            "info": "Products will be pulled from the selected collection.",
            "label": "Collection"
        }
    ],
    "presets": [
        {
            "name": "Featured Products",
            "category": "Sections"
        }
    ]
}

{% endschema %}
