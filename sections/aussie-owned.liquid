    </svg>
  </div>

  <div class="grid-container">
    <div class="grid-x grid-margin-x align-middle mb-30">
      <div class="cell medium-auto text-center medium-text-left">
        <h2>{{ section.settings.section_title }}</h2>
        <p class="m-0">{{ section.settings.section_content }}</p>
      </div>
      {% if section.settings.button_title != blank and section.settings.button_page != blank %}
      <div class="cell medium-shrink text-center">
        <a href="{{ section.settings.button_page }}" class="button button-primary">{{ section.settings.button_title }}</a>
      </div>
      {% endif %}
    </div>
  </div>

  <div class="grid-container">
    <div class="profile-slider">
      <div class="glide">
        <div data-glide-el="track" class="glide__track">
          <div class="glide__slides">
            {% for block in section.blocks %}
              <div>
               <img data-src="{{ block.settings.image | img_url: '150x' }}" class="profile-slider__image lazyload">
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>

</div>


{% schema %}
{
  "name": "Aussie Owned",
  "settings": [
  {
      "type": "header",
      "content": "Section Title"
  },
  {
      "type": "text",
      "id": "section_title",
      "label": "Title",
      "default": "Your Most Loved"
  },
  {
      "type": "text",
      "id": "section_content",
      "label": "Content"
  },
  {
      "type": "header",
      "content": "Section Button"
  },
  {
      "type": "text",
      "id": "button_title",
      "label": "Button title",
      "default": "See More"
  },
  {
      "type": "url",
      "id": "button_page",
      "label": "Link"
  }
  ],
  "blocks": [
  {
    "type": "profile_block",
    "name": "Profile",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Profile Image"
      }
    ]
  }
  ],
  "presets": [
  {
    "name": "Aussie Owned",
    "category": "Sections"
  }
  ]
}

{% endschema %}
