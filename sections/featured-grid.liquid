<div class="section section-featured-grid {{ section.settings.section_theme }}" data-autoload-section="featured-grid">

  <div class="grid-container">
    <h2>{{ block_size_divide }}</h2>
    <div class="grid-x grid-margin-x align-middle mb-30">
      <div class="cell medium-auto text-center">
        <h2>{{ section.settings.section_title }}</h2>
      </div>
    </div>
  </div>

  <div class="grid-container">


    <div class="slider-wrapper">
      <div class="glide">
        <div data-glide-el="track" class="glide__track">


    <div class="glide__slides grid-x grid-margin-y grid-margin-x">

      {% for block in section.blocks %}
        {% assign large_class = block.settings.column_size %}


        {% if large_class == 'small-12' or large_class == 'medium-6' %}
          {% assign image_url = block.settings.image | img_url: '600x' %}
        {% else %}
          {% assign image_url = block.settings.image | img_url: '500x500', crop: 'center' %}
        {% endif %}


        <div class="cell {{ large_class }}">
          {% if block.settings.url != blank %}<a href="{{ block.settings.url }}">{% endif %}
          <img
              class="feature-item__image lazyload"
              data-src="{{ image_url }}"
              alt="{{block.settings.image}}"
          >
          {% if block.settings.url != blank %}</a>{% endif %}
        </div>

      {% endfor %}

    </div>

        </div>
      </div>
    </div>

  </div>

</div>

{% schema %}

{
    "name": "Featured Grid",
    "settings": [
         {
          "type": "header",
          "content": "Section Theme"
        },
        {
          "type": "select",
          "id": "section_theme",
          "options": [
            { "value": "", "label": "White"},
            { "value": "theme-light", "label": "Light Grey"},
            { "value": "theme-split", "label": "Split White/Light Grey"},
            { "value": "theme-split-alt", "label": "Split Light Grey/White"}
          ],
          "label": "Section Theme"
        },
        {
          "type": "header",
          "content": "Section Title"
        },
        {
          "type": "text",
          "id": "section_title",
          "label": "Title",
          "default": "Your Most Loved"
        }
    ],
    "blocks": [
      {
        "type": "feature_block",
        "name": "Feature",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "url",
            "id": "url",
            "label": "Link"
          },
          {
           "type": "select",
           "id": "column_size",
           "label": "Columns",
            "default": "medium-3 small-6",

           "options": [
             {
               "value": "small-12",
               "label": "1/1"
             },
             {
               "value": "medium-6",
               "label": "1/2"
             },
            {
              "value": "medium-4 small-6",
              "label": "1/3"
            },
            {
              "value": "medium-3 small-6",
              "label": "1/4"
            }
           ]
        }
        ]
      }
    ],
    "presets": [
        {
            "name": "Featured Grid",
            "category": "Sections"
        }
    ]
}

{% endschema %}
