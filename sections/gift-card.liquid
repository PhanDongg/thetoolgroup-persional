{% assign simple_url = shop.url | split: "//" %}
{% assign simple_url = simple_url[1] %}
<div class="grid-container">
  <div class="grid-x align-center text-center">
    <div class="cell large-5 medium-7">
      <div class="gift-card-wrapper">
        <div class="gift-card-inner">
          <h1>{{ 'gift_cards.issued.subtext' | t }}</h1>
          {% unless gift_card.enabled %}
            <span class="giftcard-tag">{{ 'gift_cards.issued.disabled' | t }}</span>
          {% endunless %}

          <div class="gift-card-image-wrapper">
            <img src="{{ 'gift-card/card.jpg' | shopify_asset_url }}" alt="Gift card illustration">
            <div class="gift-card-code">{{ gift_card.code | format_code }}</div>
          </div>

          <h2>{{ 'gift_cards.issued.redeem' | t }}</h2>
          <div class="gift-card-value">{{ gift_card.balance | money }}</div>
          <h2>To spend at <a href="{{shop.url}}">{{ simple_url }}</a></h2>

          {% if gift_card.pass_url %}
            <a href="{{ gift_card.pass_url }}" class="apple-wallet">
              <img class="apple-wallet-image" src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}">
            </a>
          {% endif %}
          <div class="gift-card-footer">
            {% assign gift_card_expiry_date = gift_card.expires_on | date: "%d/%m/%y" %}
            {% unless gift_card_expiry_date == blank %}
              <div class="gift-card-expiry">Expires on {{gift_card_expiry_date}}</div>
            {% endunless %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
