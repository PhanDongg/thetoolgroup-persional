<div class="section section-article-listing no-margin-top" data-autoload-section="article-listing">
    <div class="grid-container">

        <div class="article-listing__tags">
            <a class="article-listing__tag {% if current_tags == blank %} active{% endif %}"
               href="{{ blog.url }}">View All</a>
            {% for tag in blog.all_tags %}
                <a class="article-listing__tag{% if current_tags contains tag %} active{% endif %}"
                   href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
            {% endfor %}
        </div>

        {% paginate blog.articles by 12 %}

            <div class="grid-x grid-margin-x grid-margin-y">

                {% for article in blog.articles %}
                    <div class="cell small-12 medium-6 large-4">
                        {% render 'article-tile', article: article %}
                    </div>
                {% endfor %}

            </div>

            {% if paginate.pages > 1 %}
                {% render 'pagination' paginate: paginate %}
            {% endif %}

        {% endpaginate %}

    </div>
</div>
