<div class="section section-banner no-margin theme-dark" data-autoload-section="banner">
  <div class="glide h-100">
    <div class="banner-slider-bullets glide__bullets" data-glide-el="controls[nav]">
      {% for block in section.blocks %}
        <button class="glide__bullet" data-glide-dir="={{ forloop.index0 }}"><span></span></button>
      {% endfor %}
    </div>
    <div data-glide-el="controls" class="banner-slider-controls slider-controls">
      <button data-glide-dir="<" class="slider-arrow slider-prev"><span class="show-for-sr">Previous</span>{% render 'icon-arrow-right' %}</button>
      <button data-glide-dir=">" class="slider-arrow slider-next"><span class="show-for-sr">Next</span>{% render 'icon-arrow-right' %}</button>
    </div>
    <div data-glide-el="track" class="glide__track h-100">
      <div class="glide__slides grid-x align-middle h-100">
        {% for block in section.blocks %}
          <div class="banner-slide grid-y align-center cell h-100" {{ block.shopify_attributes }}>
            {% if block.settings.img_link != blank %}
              <a href="{{ block.settings.img_link }}">
            {% endif %}
            <picture>
              {% if block.settings.mobile_image != blank %}
                <source
                        {% unless forloop.index0 == 0 %}data-{% endunless %}srcset="{{ block.settings.mobile_image | img_url: '640x' }}"
                        media="(max-width: 640px)"
                >
              {% endif %}
              <img
                      {% unless forloop.index0 == 0 %}data-{% endunless %}src="{{ block.settings.image | img_url: '1140x' }}"
                      {% unless forloop.index0 == 0 %}data-{% endunless %}srcset="{{ block.settings.image | img_url: '1400x' }} 1400w, {{ block.settings.image | img_url: '1100x' }} 1100w, {{ block.settings.image | img_url: '800x' }} 800w, {{ block.settings.image | img_url: '450x' }} 450w"
                      class="banner-image lazyload"
                      alt="{{ section.settings.image.alt }}"
              >
            </picture>
            {% if block.settings.img_link != blank %}
              </a>
            {% endif %}
            <div class="banner-content-wrapper">
              <div class="grid-container">
                <div class="grid-x grid-margin-x align-center align-middle banner-grid">
                  {% unless block.settings.forefront_image == blank %}
                    <div class="cell medium-5">
                      <img class="lazyload" data-src="{{ block.settings.forefront_image | img_url: '480x' }}"/>
                    </div>
                  {% endunless %}
                  <div class="cell medium-5">
                    <div class="h6">{{ block.settings.subtitle }}</div>
                    <div class="h1 banner-content-header">{{ block.settings.title }}</div>
                    <p class="lead mb-30">{{ block.settings.content }}</p>
                    {% if block.settings.link != blank %}
                      <a class="button button-white" href="{{block.settings.link}}">
                        {{block.settings.cta}}
                        <span class="ml-10">{% render 'icon-arrow-right' %}</span>
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

</div>

{% schema %}
{
  "name": "Banner",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "BG Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "BG Image Mobile"
        },
        {
          "type": "image_picker",
          "id": "forefront_image",
          "label": "Forefront Image"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Button Text",
          "default": "See More"
        },
        {
          "type": "url",
          "id": "img_link",
          "label": "Image Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner",
      "category": "Sections"
    }
  ]
}
{% endschema %}
