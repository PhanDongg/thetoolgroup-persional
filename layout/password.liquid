<!doctype html>
<!--[if IE 9]> <html class="ie9 no-js" lang="{{ shop.locale }}"> <![endif]-->
<!--[if (gt IE 9)|!(IE)]><!--> <html class="no-js" lang="{{ shop.locale }}"> <!--<![endif]-->
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_accent }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {% if settings.favicon != blank %}
    <link rel="shortcut icon" href="{{ settings.favicon | img_url: '32x32' }}" type="image/png">
  {% endif %}

  <title>{{ shop.name }}</title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {% render 'style-tags', layout: 'theme' %}

  {% render 'social-meta-tags' %}

  {{ content_for_header }}
</head>

<body class="template-password">
  <header role="banner">
    <div class="grid-container"><h1 class="main-bar-logo-text">{{ shop.name }}</h1></div>
  </header>

  <main role="main" id="MainContent">
    <div class="grid-container">
      <div class="grid-x grid-margin-x">
        <!-- <div class="cell medium-6">
          {{ content_for_layout }}
        </div> -->

        <div class="cell medium-8 large-6">
          <div id="Login">
            <h4>{{ 'general.password_page.login_form_heading' | t }}</h4>
            {% form 'storefront_password' %}
              {{ form.errors | default_errors }}
              <div class="grid-x grid-margin-x align-bottom">
                <div class="cell grow">
                  <label for="password">{{ 'general.password_page.login_form_password_label' | t }}</label>
                  <input type="password"
                    name="password"
                    id="Password"
                    autofocus
                    placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}">
                  </div>
                  <div class="cell medium-auto">
                    <button type="submit" name="commit" class="button button-primary">
                      {{ 'general.password_page.login_form_submit' | t }}
                    </button>
                  </div>
                </div>
            {% endform %}
            <p>{{ 'general.password_page.admin_link_html' | t }}</p>
          </div>
        </div>
    </div>
  </main>


  {% render 'script-tags', layout: 'theme' %}
  {% render 'ext-fonts' %}
</body>
</html>
